---
import Layout from "../layouts/layout.astro";
import ImageMarquee from "../components/ImageMarquee";
import RichParagraph from "../components/RichParagraph.astro";
import { aboutPage } from "../constants/pages";
---

<script>
  import { animate } from "motion";

  const pulse = document.getElementById("pulse");
  const available = document.getElementById("available");

  if (pulse && available) {
    document.addEventListener("mousemove", (e) => {
      available.style.left = `${e.clientX + 15}px`;
      available.style.top = `${e.clientY + 10}px`;
      available.style.position = "fixed";
    });
    pulse.addEventListener("mouseenter", () => {
      animate(available, { opacity: 1 }, { duration: 0.3 });
    });
    pulse.addEventListener("mouseleave", () => {
      animate(available, { opacity: 0 }, { duration: 0.1 });
    });
  }
</script>

<Layout title="About">
  <main>
    <div class="mb-6">
      <div class="flex items-center gap-3">
        <h1>{aboutPage.name}</h1>
        {
          aboutPage.availableForWork && (
            <>
              <div
                id="pulse"
                class="relative cursor-pointer z-20 flex items-center justify-center"
              >
                <div class="absolute w-4 bg-[#E0FAEC] aspect-square rounded-full -z-10" />
                <div class="w-2.5 aspect-square bg-[#1FC16B] rounded-full" />
              </div>
              <div
                id="available"
                class="px-2.5 absolute opacity-0 p-1 rounded-b-xl shadow-xl shadow-[#00000010] rounded-tr-xl rounded-tl-xs bg-[#FDEBFF] dark:bg-[#272727] border-border border"
              >
                <span class="text-[#620F6C] dark:text-[#F9C6FF] text-sm">
                  {aboutPage.availabilityLabel}
                </span>
              </div>
            </>
          )
        }
      </div>
      <p>{aboutPage.tagline}</p>
    </div>
    <div class="overflow-hidden h-[340px] sm:mt-6 mt-4 sm:h-[600px] rounded-2xl">
      <img
        src={aboutPage.image}
        class="rounded-2xl object-cover h-[600px] object-[55%_10%] -translate-y-[50px] sm:translate-y-0 sm:h-[600px] sm:object-[55%_0%] w-full"
        alt=""
      />
    </div>
    <div class="mt-5 flex flex-col gap-8">
      {aboutPage.paragraphs.map((paragraph) => <RichParagraph text={paragraph} />)}
    </div>
    <div class="mt-8">
      <h1 class="mb-4 text-[15px]">{aboutPage.experienceTitle}</h1>
      <div class="flex flex-col mt-4 gap-1">
        {
          aboutPage.experiences.map((experience) => (
            <div class="flex justify-between items-center py-2 group">
              <p class="group-hover:font-normal">{experience.company}</p>
              <p class="group-hover:font-normal">{experience.role}</p>
            </div>
          ))
        }
      </div>
    </div>
    <div class="mt-8">
      <h1 class="mb-4 text-[15px]">{aboutPage.beyondTitle}</h1>
      {aboutPage.beyondParagraphs.map((paragraph) => <RichParagraph text={paragraph} />)}
    </div>
    <div class="mt-[86px] mb-40">
      <ImageMarquee images={aboutPage.marqueeImages} client:load />
    </div>
  </main>
</Layout>
