---
import "../styles/global.css";
import Layout from "../layouts/layout.astro";
import RecentWorks from "../components/recent_works.astro";
import RichParagraph from "../components/RichParagraph.astro";
import { homePage } from "../constants/pages";
---

<Layout title="Dami Ojetunji">
  <main>
    <img
      src={homePage.avatar}
      class="w-[60px] rounded-full mb-10 aspect-square"
    />
    <div class="flex flex-col gap-6 sm:gap-8">
      <h1>{homePage.heading}</h1>
      {homePage.paragraphs.map((paragraph) => <RichParagraph text={paragraph} />)}
    </div>

    <RecentWorks />
  </main>
</Layout>
