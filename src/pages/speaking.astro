---
import { ExternalLink } from "@lucide/astro";
import Layout from "../layouts/layout.astro";
import ImageMarquee from "../components/ImageMarquee";
import RichParagraph from "../components/RichParagraph.astro";
import { speakingPage } from "../constants/pages";
---

<Layout title="Speaking">
  <main>
    <div class="sm:mb-6 mb-[18px]">
      <h1>{speakingPage.title}</h1>
      {
        speakingPage.intro.map((paragraph, i) => (
          <RichParagraph text={paragraph} class={i === 0 ? "mt-1" : undefined} />
        ))
      }
    </div>
    <div class="sm:mb-18 mb-[18px]">
      <ImageMarquee images={speakingPage.marqueeImages} client:load />
    </div>

    <div class="flex flex-col">
      <h1>{speakingPage.pastEventsTitle}</h1>
      <div class="flex flex-col">
        {
          speakingPage.pastEvents.map((event) => (
            <div class="group hover:opacity-60 transition-opacity cursor-pointer">
              <a
                href={event.link}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-start justify-between gap-4 pt-4 pb-6 border-b border-border last:border-b-0"
              >
                <div class="flex-1">
                  <h4 class="mb-2 group-hover:text-dark-text transition-colors">
                    {event.title}
                  </h4>
                  <h3 class="text-xs uppercase tracking-wider">
                    {event.venue}
                  </h3>
                </div>
                <ExternalLink
                  size={18}
                  stroke-width={2.5}
                  color="var(--color-text)"
                  class="text-text flex-shrink-0 mt-1 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                />
              </a>
            </div>
          ))
        }
      </div>
    </div>
    <div class="flex mt-11 flex-col">
      <h1 class="mb-1">{speakingPage.notesTitle}</h1>
      <p>{speakingPage.notesIntro}</p>
      <div class="flex flex-col">
        {
          speakingPage.notes.map((note) => (
            <div class="group hover:opacity-60 transition-opacity cursor-pointer">
              <a
                href={note.link}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-start justify-between gap-4 pt-4 pb-6 border-b border-border last:border-b-0"
              >
                <div class="flex-1">
                  <h4 class="mb-2 group-hover:text-dark-text transition-colors">
                    {note.title}
                  </h4>
                  <h3 class="text-xs uppercase tracking-wider">{note.venue}</h3>
                </div>
                <ExternalLink
                  size={18}
                  stroke-width={2.5}
                  color="var(--color-text)"
                  class="text-text flex-shrink-0 mt-1 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
