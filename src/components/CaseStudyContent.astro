---
import RichTextParagraph from "./rich-text-paragraph.astro";
import ImageSlider from "./ImageSlider";
import type { CaseStudy } from "../constants/case_studies";
import { caseStudies, caseStudyHasContent } from "../constants/case_studies";
import { CopyIcon, LucideArrowRight } from "lucide-react";
import Button from "./ui/button";

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;

// Find the next case study with content
const currentIndex = caseStudies.findIndex(
  (study) => study.slug === caseStudy.slug,
);
let nextCaseStudy: CaseStudy | undefined;

// Look for the next case study with content, starting from the next index
for (let i = 1; i <= caseStudies.length; i++) {
  const nextIndex = (currentIndex + i) % caseStudies.length;
  const candidate = caseStudies[nextIndex];
  if (caseStudyHasContent(candidate)) {
    nextCaseStudy = candidate;
    break;
  }
}
---

<script>
  const copyEmailButton = document.querySelector("#copyEmail") as HTMLElement;
  const successMessage = document.querySelector(
    "#copySuccessMessage",
  ) as HTMLElement;

  if (copyEmailButton && successMessage) {
    copyEmailButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("dami@jointabs.com");

        // Hide the copy icon and show success message
        copyEmailButton.style.opacity = "0";
        successMessage.style.display = "block";

        setTimeout(() => {
          copyEmailButton.style.opacity = "1";
          successMessage.style.display = "none";
        }, 2000);
      } catch (err) {
        console.error("Failed to copy email:", err);
      }
    });
  }
</script>

<h4 class="mb-4 w-full max-w-180 sm:hidden">{caseStudy.pageTitle}</h4>
<!-- Dynamic Sections -->
{
  caseStudy.sections.map((section) => {
    const hideOnSmaller = section.hideOnSmallerScreen === true;
    const hiddenClass = hideOnSmaller ? "hidden sm:block" : "";

    if (section.type === "text") {
      const sectionId = section.title
        .toLowerCase()
        .replace(/\s+/g, "-")
        .replace(/&/g, "and");
      const showTitle = section.showTitle !== false;
      return (
        <div
          id={sectionId}
          class={`mb-8 relative max-w-180 w-full scroll-mt-8 ${hiddenClass}`}
          data-section={sectionId}
        >
          {showTitle && <h2 class="mb-4">{section.title}</h2>}
          <div class="space-y-2 sm:space-y-2">
            {section.paragraphs.map((paragraph) => (
              <RichTextParagraph paragraph={paragraph} />
            ))}
          </div>
          {section.customHtml && (
            <div class="mt-4" set:html={section.customHtml} />
          )}
        </div>
      );
    } else if (section.type === "image") {
      return (
        <div class={`mb-8 relative max-w-180 w-full ${hiddenClass}`}>
          <img
            src={section.src}
            class={`w-full rounded-lg ${section.darkSrc ? "dark:hidden" : ""}`}
          />
          {section.darkSrc && (
            <img
              src={section.darkSrc}
              class="w-full rounded-lg hidden dark:block"
            />
          )}
          {section.caption && (
            <p class="mt-2 uppercase font-medium leading-4 tracking-[1.2px] text-[11px] text-soft">
              {section.caption}
            </p>
          )}
          {section.customHtml && (
            <div class="mt-4" set:html={section.customHtml} />
          )}
        </div>
      );
    } else if (section.type === "slider") {
      return (
        <div class={`mb-8 relative  ${hiddenClass}`}>
          <ImageSlider
            id={Math.random().toString(36).substring(2, 15)}
            images={section.images}
            client:load
          />
          {section.customHtml && (
            <div
              class="mt-4 max-w-180 w-full mx-auto"
              set:html={section.customHtml}
            />
          )}
        </div>
      );
    } else if (section.type === "summary") {
      return (
        <div class={`mb-8 max-w-180 relative w-full ${hiddenClass}`}>
          <div class="flex flex-col lg:flex-row gap-8 lg:gap-15">
            <div class="flex-1 space-y-2">
              <div>
                <p class="text-xs">Role</p>
                <p class="font-[200] text-dark-text">{section.role}</p>
              </div>
              <div>
                <p class="text-xs">Responsibilities</p>
                <p class="font-[200] text-dark-text">
                  {section.responsibilities}
                </p>
              </div>
              {section.deliverables.length > 0 && (
                <div>
                  <p class="text-xs">Deliverables</p>
                  <p class="font-[200] text-dark-text">
                    {section.deliverables.join(", ")}
                  </p>
                </div>
              )}
              <div>
                <p class="text-xs">Timeline</p>
                <p class="font-[200] text-dark-text">{section.timeline}</p>
              </div>
              {section.team.length > 0 && (
                <div>
                  <p class="text-xs">Team</p>
                  <div class="flex flex-col mt-2 gap-2">
                    {section.team.map((member) => (
                      <div class="flex items-center gap-3">
                        <img
                          src={member.image}
                          class="w-6 h-6 rounded-full object-cover"
                        />
                        <p class="font-[200]">
                          <span class="text-dark-text font-[200]">
                            {member.name}
                          </span>{" "}
                          / {member.role}
                        </p>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
            {section.sideParagraphs.length > 0 && (
              <div class="space-y-4 max-w-85">
                {section.sideParagraphs.map((paragraph) => {
                  const isObject =
                    typeof paragraph === "object" && paragraph !== null;
                  const isHidden =
                    isObject &&
                    "hidden" in paragraph &&
                    paragraph.hidden === true;
                  const paragraphContent =
                    isObject && "content" in paragraph
                      ? paragraph.content
                      : (paragraph as string);
                  const hiddenClass = isHidden ? "hidden sm:block" : "";

                  return <p class={hiddenClass}>{paragraphContent}</p>;
                })}
              </div>
            )}
          </div>
          {section.customHtml && (
            <div class="mt-4" set:html={section.customHtml} />
          )}
        </div>
      );
    } else if (section.type === "html") {
      const maxWidthClass = section.maxWidth || "max-w-180";
      return (
        <div
          class={`mb-8 relative ${maxWidthClass} w-full ${hiddenClass}`}
          set:html={section.content}
        />
      );
    }
  })
}
<p class="sm:hidden">
  👁️ For optimal viewing, please view this case study on a larger screen.
</p>

<!-- Notes Section -->
{
  caseStudy.notes.length > 0 && (
    <div class="mt-20 max-w-180 w-full sm:mt-24 md:mt-32">
      <ul class="space-y-8 sm:space-y-10">
        {caseStudy.notes.map((note) => (
          <li class="flex items-start">
            <p class="text-soft">{note}</p>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  nextCaseStudy && (
    <a
      href={`/case-study/${nextCaseStudy.slug}`}
      class="w-full mt-15 sm:mt-0 max-w-180"
    >
      <Button className="w-full justify-between items-center px-3 py-2.5 rounded-xl  leading-[21px]">
        Read {nextCaseStudy.title}
        <LucideArrowRight size={18} strokeWidth={2.5} />
      </Button>
    </a>
  )
}
