---
import { LockIcon } from "lucide-react";
import Layout from "../layouts/layout.astro";
import Input from "./ui/input";
import { CopyIcon } from "@lucide/astro";
---

<Layout title="Enter password to view case study">
  <main
    class="h-full flex flex-col items-center justify-center min-h-screen px-4 sm:px-6"
  >
    <div class="space-y-2.5 w-full max-w-md">
      <h4>Password</h4>
      <div class="w-full">
        <Input hasLock placeholder="Enter password..." type="password" />
      </div>
      <div>
        <p
          class="flex flex-wrap relative items-center gap-1 text-xs sm:text-sm"
        >
          Find password on resume or{" "}
          <a
            href="mailto:dami@jointabs.com"
            class="text-dark-text font-normal cursor-pointer sm:hidden"
          >
            reach out
          </a>
          <span class="hidden sm:inline">reach out </span>
          <span
            id="email-text"
            class="hidden sm:inline text-dark-text font-normal cursor-pointer break-all"
          >
            dami@jointabs.com
          </span>
          <button
            id="copy-icon"
            class="hidden sm:flex flex-shrink-0 cursor-pointer transition-opacity hover:opacity-70"
            aria-label="Copy email to clipboard"
          >
            <CopyIcon size={14} color="#335CFF" strokeWidth={2.5} />
          </button>
          <span
            id="copy-success-message"
            class="hidden sm:block font-normal absolute -right-[140px] text-link"
            style="display: none;"
          >
            Yaay! Speak soon! 😄
          </span>
        </p>
      </div>
    </div>
  </main>
</Layout>

<script>
  const emailText = document.getElementById("email-text");
  const copyIcon = document.getElementById("copy-icon");
  const successMessage = document.getElementById("copy-success-message");

  async function handleCopyEmail() {
    try {
      await navigator.clipboard.writeText("dami@jointabs.com");

      if (copyIcon && successMessage) {
        copyIcon.style.opacity = "0";
        successMessage.style.display = "block";

        setTimeout(() => {
          copyIcon.style.opacity = "1";
          successMessage.style.display = "none";
        }, 2000);
      }
    } catch (err) {
      console.error("Failed to copy email:", err);
    }
  }

  emailText?.addEventListener("click", handleCopyEmail);
  copyIcon?.addEventListener("click", handleCopyEmail);
</script>
