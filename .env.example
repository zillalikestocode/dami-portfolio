# When set, the portfolio fetches case studies from the portfolio-admin public
# endpoint at build time instead of using the local fallback data.
# Leave unset to use the bundled fallback (src/constants/case_studies.ts).
# CASE_STUDIES_API_URL=https://your-admin.vercel.app/api/public/case-studies

# When set, the portfolio fetches the Home/About/Speaking page content from the
# portfolio-admin public endpoint at build time instead of the local fallback.
# Leave unset to use the bundled fallback (src/constants/pages.ts).
# PAGES_API_URL=https://your-admin.vercel.app/api/public/pages
